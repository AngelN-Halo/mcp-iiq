# Incident IQ tenant root, without /api/v1.0.
IIQ_BASE_URL=https://your-district.incidentiq.com

# Read-only IIQ API token. Never commit this value.
IIQ_API_TOKEN=replace-with-read-only-token

# Tenant metadata from Admin > Developer Tools. Leave optional values blank if
# Incident IQ confirms they are not required for your endpoints.
IIQ_SITE_ID=
IIQ_PRODUCT_ID=
IIQ_CLIENT_HEADER=ApiClient

# Separate bearer token used by callers of this OpenAPI service.
API_ACCESS_TOKEN=replace-with-a-long-random-secret

IIQ_TIMEOUT_SECONDS=20
IIQ_MAX_RESPONSE_BYTES=5000000
IIQ_VERIFY_SSL=true

# Short-lived CSV exports are written only to the container's /tmp filesystem.
IIQ_EXPORT_MAX_ROWS=25000
IIQ_EXPORT_PAGE_SIZE=200
IIQ_REPORT_TTL_SECONDS=900
# Optional external service origin, for example https://iiq-mcp.example.org.
# When blank, download links use the request's scheme and host.
IIQ_PUBLIC_BASE_URL=

# Existing private Docker network used by trusted internal callers.
IIQ_INTERNAL_NETWORK=iiq-internal

# Advanced GET-only access is disabled by default. If enabled, requests remain
# restricted to these resource prefixes and can never issue writes.
IIQ_ENABLE_ADVANCED_READ=false
IIQ_ALLOWED_READ_PREFIXES=tickets,assets,users,locations,categories,issues,products
